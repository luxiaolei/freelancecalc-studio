---
import Base from "@/layouts/Base.astro";
import { tools } from "@/data/tools";
const featuredTools = tools.slice(0, 6);
---

<Base title="FreelanceCalc Studio" description="Client-side calculators for freelancers and small businesses: pricing, quotes, retainers, fees, and billable-hour planning.">
  <section class="section pt-14">
    <div class="container">
      <div class="row items-center justify-between">
        <div class="lg:col-7 mb-8">
          <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-primary">Static-first Micro-SaaS MVP</p>
          <h1 class="mb-5 text-h2 lg:text-h1">Freelance pricing calculators with transparent formulas.</h1>
          <p class="mb-8 text-lg">A focused tool cluster for freelancers and small businesses. Calculate hourly-to-salary equivalents, project quotes, retainers, platform fees, billable-hour break-even points, and meeting costs without creating an account.</p>
          <div class="flex flex-wrap gap-3">
            <a class="btn btn-primary" href="/tools">Explore calculators</a>
            <a class="btn btn-outline-primary" href="/privacy-policy">Privacy-first MVP</a>
          </div>
        </div>
        <div class="lg:col-5">
          <div class="rounded-2xl border border-border bg-gradient p-6 shadow-sm">
            <h2 class="mb-4 text-h4">MVP quality gate</h2>
            <ul class="space-y-3 text-sm">
              <li>✓ Client-side calculators</li>
              <li>✓ Formula, assumptions, examples, and FAQ on every page</li>
              <li>✓ No login, no database, no saved PII</li>
              <li>✓ Informational-use disclaimer on money-related tools</li>
              <li>✓ Coherent freelancer/pricing cluster before cross-niche expansion</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-sm bg-gradient">
    <div class="container">
      <div class="mb-8 text-center">
        <h2 class="mb-3 text-h3">First freelancer calculator batch</h2>
        <p>Ten formula-based tools for pricing, revenue, fees, and operating discipline.</p>
      </div>
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {featuredTools.map((tool) => (
          <a class="rounded-2xl border border-border bg-body p-6 transition hover:-translate-y-1 hover:border-primary" href={`/tools/${tool.slug}`}>
            <h3 class="mb-2 text-h5">{tool.title}</h3>
            <p class="text-sm">{tool.description}</p>
          </a>
        ))}
      </div>
      <div class="mt-8 text-center">
        <a class="btn btn-primary" href="/tools">View all 10 tools</a>
      </div>
    </div>
  </section>
</Base>
