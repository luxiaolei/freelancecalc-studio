    "label": "All Tools",
    "link": "/tools"
  },

  "google_tag_manager": {
    "enable": false,
    "gtm_id": "GTM-XXXXXX"
  },

  "disqus": {
    "enable": false,
    "shortname": "",
    "settings": {}
  },

  "metadata": {
    "meta_author": "AlphaBeta",
    "meta_image": "/images/og-image.png",
    "meta_description": "Client-side calculators for freelancer pricing, project quotes, retainers, fees, and billable-hour planning."
  },

  "llms": {
    "generate_llms_txt": true,
    "generate_llms_full_txt": true,
